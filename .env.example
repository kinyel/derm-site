# Copy to .env for local work. In Cloudflare Pages set these under Settings → Environment variables.
SITE_URL=                      # e.g. https://www.yourdomain.com (overrides clinic.ts domain)
PUBLIC_GA4_ID=                 # G-XXXXXXXXXX  (analytics is omitted when empty)
PUBLIC_CLARITY_ID=             # Microsoft Clarity project id (omitted when empty)
PUBLIC_TURNSTILE_SITE_KEY=     # Cloudflare Turnstile site key (widget omitted when empty)
# Pages Function (server side only)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=              # overrides the email in clinic.ts
CONTACT_FROM_EMAIL=            # a sender on a domain verified with Resend
INDEXNOW_KEY=                  # 32-char key; the build writes /{key}.txt when set
