{
  "name": "oc-clinics-site",
  "version": "1.0.0",
  "description": "O.C Clinics website",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
