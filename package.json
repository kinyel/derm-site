  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdoc": "^2.1.5",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/react": "^7.1.9",
    "@axe-core/playwright": "^4.14.0",
    "@huggingface/transformers": "^4.3.2",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.10",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "node-html-parser": "^9.0.7",
    "pagefind": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.166.0",
    "yaml": "^2.9.1"
