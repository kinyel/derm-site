    "test:e2e": "playwright test",
    "test:seo": "node scripts/test-seo.mjs",
    "lhci": "node scripts/lhci.mjs",
    "test:keywords": "node scripts/test-keywords.mjs",
    "contrast": "node scripts/contrast.mjs",
    "posters": "node scripts/posters.mjs",
    "hero:depth": "node scripts/hero-depth.mjs",
    "favicons": "node scripts/favicons.mjs",
    "images:missing": "node scripts/images-missing.mjs",
    "images:refresh": "node scripts/images-refresh.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2026-11-01",
    "test:all": "node scripts/run-all.mjs",
    "test:cls": "node scripts/cls-probe.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "astro": "^7.4.13",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
