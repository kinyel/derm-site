---
/**
 * Primary / secondary / WhatsApp buttons, in the owner's PrimeTrack shape (D75): a rectangular plate
 * with a round arrow chip at the end. A primary button always carries the chip; a secondary one
 * carries it unless it has a leading icon (phone, directions), which says more than an arrow would.
 * Tertiary links use the `.link` class.
 */
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'whatsapp';
  size?: 'm' | 'small' | 'large';
  /** The arrow chip at the end. Default: on for primary, and for secondary without an icon. */
  arrow?: boolean;
  icon?: string;
  block?: boolean;
  type?: 'button' | 'submit';
  disabled?: boolean;
  loading?: boolean;
  /** Analytics event name (book_click, whatsapp_click, call_click, directions_click). */
  event?: string;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'm', icon, arrow, block = false, type = 'button', disabled = false, loading = false, event, class: cls, ...rest } = Astro.props;
const showArrow = arrow ?? (variant === 'primary' || (variant === 'secondary' && !icon));
const showIcon = Boolean(icon) && !(variant === 'primary' && showArrow);
const Tag = href ? 'a' : 'button';
const external = href?.startsWith('http');
const classes = ['btn', `btn--${variant}`, size === 'small' && 'btn--small', size === 'large' && 'btn--large', showArrow && 'btn--arrow', block && 'btn--block', loading && 'is-loading', cls];
---

<Tag
  class:list={classes}
  href={href}
  type={href ? undefined : type}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  aria-busy={loading ? 'true' : undefined}
  data-event={event}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  {...rest}
>
  {
    variant === 'whatsapp' ? (
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="url(#icon-grad-leaf)"
          fill-rule="evenodd"
          d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3zM9.3 7.9c-.3 0-.7.2-.9.6-.3.6-.5 1.3-.2 2.1.5 1.5 1.5 2.9 2.9 3.9 1 .8 2.2 1.3 3.2 1.4.7.1 1.4-.2 1.8-.7.2-.3.3-.7.2-1l-1.7-.9c-.2-.1-.5 0-.6.2l-.5.6c-.1.2-.3.2-.5.1a5.6 5.6 0 0 1-2.6-2.3c-.1-.2-.1-.4.1-.6l.4-.5c.2-.2.2-.4.1-.6l-.7-1.8c-.1-.3-.3-.5-.5-.5z"
        />
      </svg>
    ) : showIcon ? (
      <Icon name={icon!} solid />
    ) : null
  }
  <span class="btn__label"><slot /></span>
  {
    showArrow && (
      <span class="btn__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    )
  }
</Tag>
