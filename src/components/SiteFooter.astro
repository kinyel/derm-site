---
/** Footer (§10.7): facts from clinic.ts; links generated from content collections. */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { clinic, telHref, whatsappHref, emailHref, directionsHref, socialLinks, experienceStatement } from '../data/clinic.ts';
import { legalPages } from '../data/taxonomy.ts';
import { loadAll, paths, topConditions } from '../lib/content.ts';

const all = await loadAll();
const top = topConditions(all);
const latest = all.articles.slice(0, 4);
const year = new Date().getFullYear();
---

<footer class="band band--night on-night footer" id="site-footer">
  <span class="band__ribbon" aria-hidden="true"></span>
  <div class="container">
    <div class="footer__rule" aria-hidden="true"></div>
    <div class="footer__grid">
      <div class="stack" style="--stack: var(--space-s)">
        <a class="footer__brand" href="/" aria-label={`${clinic.name} home`}><Logo /></a>
        <p class="text-soft">Dermatology, aesthetics and laser, and internal medicine in {clinic.address.neighbourhood}, {clinic.city}. {experienceStatement()}</p>
        <address>
          {clinic.address.displayed}<br />
          <a class="link" href={directionsHref} target="_blank" rel="noopener noreferrer" data-event="directions_click">Get directions</a>
        </address>
        <table class="hours">
          <caption class="visually-hidden">Opening hours</caption>
          <tbody>
            {clinic.hours.map((h) => (
              <tr>
                <th scope="row">{h.label}</th>
                <td>{h.display}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <ul class="link-list" role="list">
          <li><a href={telHref} data-event="call_click"><span>Call {clinic.phone.display}</span></a></li>
          <li><a href={whatsappHref} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click"><span>Chat on WhatsApp</span></a></li>
          {emailHref && <li><a href={emailHref}><span>{clinic.email}</span></a></li>}
          <li><a href="/dermatologist-victoria-island-lekki/"><span>Dermatologist in {clinic.address.addressLocality}: how to find us</span></a></li>
        </ul>
      </div>

      <nav aria-label="Services">
        <details class="footer__group" open data-footer-group>
          <summary><h2>Services</h2><Icon name="chevron" solid class="footer__chev" /></summary>
          <ul class="link-list" role="list">
            {all.services.map((s) => (
              <li><a href={paths.service(s.id)}><span>{s.data.navLabel}</span></a></li>
            ))}
          </ul>
        </details>
      </nav>

      <nav aria-label="Conditions">
        <details class="footer__group" open data-footer-group>
          <summary><h2>Conditions</h2><Icon name="chevron" solid class="footer__chev" /></summary>
          <ul class="link-list" role="list">
            {top.map((c) => (
              <li><a href={paths.condition(c.id)}><span>{c.data.shortTitle}</span></a></li>
            ))}
            <li><a href="/conditions/"><span>All conditions A–Z</span></a></li>
          </ul>
        </details>
      </nav>

      <nav aria-label="Learn and clinic">
        <details class="footer__group" open data-footer-group>
          <summary><h2>Learn</h2><Icon name="chevron" solid class="footer__chev" /></summary>
          <ul class="link-list" role="list">
            {latest.map((a) => (
              <li><a href={paths.article(a.id)}><span>{a.data.title}</span></a></li>
            ))}
            <li><a href="/blog/"><span>All articles</span></a></li>
          </ul>
        </details>
        <details class="footer__group footer__group--next" open data-footer-group>
          <summary><h2>Clinic</h2><Icon name="chevron" solid class="footer__chev" /></summary>
          <ul class="link-list" role="list">
            <li><a href="/about/"><span>About the clinic</span></a></li>
            <li><a href="/your-visit/"><span>Your visit</span></a></li>
            <li><a href="/faq/"><span>Questions and answers</span></a></li>
            <li><a href="/book-appointment/"><span>Book an appointment</span></a></li>
            <li><a href="/contact/"><span>Contact</span></a></li>
          </ul>
        </details>
        {socialLinks.length > 0 && (
          <ul class="cluster" role="list" style="margin-block-start: var(--space-s)">
            {socialLinks.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer me" aria-label={`${clinic.name} on ${s.label}`} class="nav__phone">
                  <Icon name={s.label.toLowerCase()} solid />
                </a>
              </li>
            ))}
          </ul>
        )}
      </nav>
    </div>

    <div class="footer__legal">
      <p>© {year} {clinic.name}. Health information on this site does not replace a consultation.</p>
      <ul class="link-list" role="list" style="display:flex;flex-wrap:wrap;gap:0 var(--space-m)">
        {legalPages.map((l) => (
          <li><a href={l.href}><span>{l.label}</span></a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
