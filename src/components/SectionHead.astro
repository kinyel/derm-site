---
/**
 * Label + heading + optional lead (+ optional action on the right). Used by every section so the
 * three never drift apart from page to page (D61). Sections use h2; a page's single h1 is in its hero.
 */
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  id?: string;
  as?: 'h1' | 'h2' | 'h3';
  action?: { href: string; label: string };
  class?: string;
}
const { eyebrow, title, lead, id, as: Tag = 'h2', action, class: cls } = Astro.props;
---

<div class:list={['section-head', action && 'section-head--row', cls]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id}>{title}</Tag>
  {lead && <p>{lead}</p>}
  {
    action && (
      <a class="link link--arrow section-head__action" href={action.href}>
        {action.label} <Icon name="arrow" solid />
      </a>
    )
  }
</div>
