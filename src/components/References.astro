---
interface Props {
  items: { title: string; publisher: string; url?: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="references" aria-labelledby="references">
      <h2 id="references" class="references__title">References</h2>
      <ol>
        {items.map((r) => (
          <li>
            {r.publisher}. {r.url ? <a href={r.url} rel="noopener noreferrer">{r.title}</a> : r.title}.
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .references__title {
    font-size: var(--step-1);
    margin-block-end: var(--space-2xs);
  }
</style>
