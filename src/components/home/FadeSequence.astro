---
/**
 * Fade sequence (owner; D78, D81, rebuilt in D82): the first sections of the home page dissolve into one
 * another in place. Nothing scrolls while it fades, nothing is ever blank, and nothing sits still.
 *
 * Markup (index.astro):
 *   <FadeSequence>
 *     <div class="fade-step fade-step--hero"><div class="fade-bg"></div><div class="fade-view">…section…</div></div>
 *     <div class="fade-step"><div class="fade-bg"></div><div class="fade-view">…section…</div></div>
 *     <div class="fade-step fade-step--self">…a section that pins itself (the staircase)…</div>
 *   </FadeSequence>
 *   Inside a section, `data-fade="text"` marks the words and `data-fade="visual"` the picture.
 *
 * How it works
 *   HELD IN PLACE. Every section sits in a window the height of the screen that the browser itself holds
 *   still (`position: sticky`). A section taller than the screen is moved up inside its window as you
 *   scroll, so all of it is read; then it rests; then it hands over. The next section's window is pulled
 *   up underneath (negative margin) and is already held in the same place when the hand-over starts.
 *   Script never positions a window, so nothing can lag behind the scroll.
 *
 *   NEVER ON TOP OF EACH OTHER, NEVER BLANK (D89). The hand-over is a quick swap in layers across half a
 *   screen of scroll: the current words and picture hold, then drop away by 48%; the next ones arrive from
 *   50% and settle by 82%, so the two sections are never on screen together; the next section's ground
 *   fades in under them across the swap, so the colour moves while the content changes and the moment
 *   where neither is clearly visible is about 15% of the hand-over (a few frames at normal speed).
 *   (D82 cross-dissolved the pictures, which showed the portrait and the photograph on top of each other.)
 *
 *   CHEAP ON A PHONE (D89). Each frame writes opacity and transform straight onto the few layers that move,
 *   and only values that changed. Earlier versions set inherited style values on each whole section, so
 *   every element in it was restyled on every scroll frame (2.2s of style work on a slowed phone over one
 *   scroll down the page). Opacity and transform are drawn by the compositor, without layout or paint.
 *
 *   NEVER STILL. While a section is held, its words and picture drift slowly against each other with the
 *   scroll and the hero's 3D turns (the scene reads `stage.__seq`). (A rail of three dots at the right
 *   edge was tried and removed at the owner's request.)
 *
 *   THE 3D. The hero's background lives in its own held layer BELOW the shared 3D canvas and the hero's
 *   words in a layer ABOVE it, as they always were, so the portrait stays behind the text and the strip.
 *   The portrait fades inside the engine (`stage.__fade`) in the frame it is drawn.
 *
 * Without JavaScript, with reduced motion, or on a screen under 600px tall, none of this applies and the
 * sections are an ordinary page. Content is never hidden from assistive technology: a section that is
 * not on screen only stops taking clicks, and focusing or linking to anything inside it brings it up.
 */
---

<div class="fade-seq" data-fade-seq>
  <slot />
</div>

<style is:global>
  .fade-bg {
    display: none;
  }
  .fade-seq[data-on] {
    --handover: 50vh;
    --handover: 50svh;
  }
  .fade-seq[data-on] > .fade-step {
    position: relative;
  }
  /* the held layers: ground below the 3D canvas, words above it */
  .fade-seq[data-on] > .fade-step > .fade-bg,
  .fade-seq[data-on] > .fade-step > .fade-view {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }
  .fade-seq[data-on] > .fade-step > .fade-bg {
    display: block;
    z-index: 0;
    margin-block-end: -100vh;
    margin-block-end: -100svh;
    background: var(--step-bg, var(--white));
    will-change: opacity;
  }
  .fade-seq[data-on] > .fade-step > .fade-view {
    z-index: var(--z-content);
    overflow: clip;
  }
  /* Safari before 16 has no clip; without either, a section taller than its window would spill out below it
     over the next one (D90). In @supports because the minifier keeps only the last of two declarations. */
  @supports not (overflow: clip) {
    .fade-seq[data-on] > .fade-step > .fade-view {
      overflow: hidden;
    }
  }
  .fade-seq[data-on] > .fade-step--hero {
    --step-bg: var(--scrim-light-inline), var(--grad-hero);
  }
  @media (max-width: 63.99em) and (orientation: portrait) {
    .fade-seq[data-on] > .fade-step--hero {
      --step-bg: var(--scrim-light-block), var(--grad-hero);
    }
  }
  .fade-seq[data-on] > .fade-step--self {
    --step-bg: var(--grad-mist);
  }
  /* each section's own ground is painted by its .fade-bg here */
  .fade-seq[data-on] > .fade-step > .fade-view > .band::before,
  .fade-seq[data-on] > .fade-step > .fade-view .hero__scrim,
  .fade-seq[data-on] > .fade-step--self > .band::before {
    display: none;
  }
  .fade-seq[data-on] > .fade-step:not(.fade-step--self) {
    height: calc(100vh + var(--len, 0px));
    height: calc(100svh + var(--len, 0px));
  }
  /* a section taller than the screen is moved up inside its window (by the script, as a transform) */
  .fade-seq[data-on] > .fade-step > .fade-view > * {
    min-height: 100%;
    will-change: transform;
  }
  /* held at the top of the screen, a section needs room for the navigation bar above its label */
  .fade-seq[data-on] > .fade-step > .fade-view > .band:not(.hero) {
    display: grid;
    align-content: center;
    padding-block-start: max(var(--space-xl), calc(var(--nav-h) + var(--space-m)));
  }
  /* the next section waits underneath, already in place when the hand-over starts */
  .fade-seq[data-on] > .fade-step + .fade-step {
    margin-block-start: calc(-100vh - var(--handover));
    margin-block-start: calc(-100svh - var(--handover));
  }
  /* the layers the script moves: each on its own compositor layer */
  .fade-seq[data-on] [data-fade] {
    will-change: opacity, transform;
  }
  .fade-seq[data-on] > .fade-step[data-inert] {
    pointer-events: none;
  }
  /* The step itself is transparent too, not only what is inside it. When the sequence switches on, a
     waiting section moves up underneath the hero; a browser scores that as a layout shift unless the
     box that moved is invisible, and it only looks at the box, not at whether anything is painted in it
     (Lighthouse measured 0.299 for exactly this on a slow phone, D84). */
  .fade-seq[data-on] > .fade-step[data-faded],
  .fade-seq[data-on] > .fade-step[data-faded] > * {
    opacity: 0;
  }
  /* A section still waiting its turn is parked below the screen as well as invisible, so it never lies
     over the section being read. It is back in place, still at zero, in the frame its hand-over begins. */
  .fade-seq[data-on] > .fade-step[data-faded='next'] > * {
    translate: 0 100vh;
  }
</style>

<script>
  type Stage = HTMLElement & { __fade?: number; __seq?: number };
  type Lenis = { scrollTo(y: number, o?: { immediate?: boolean }): void };

  /* Lengths as shares of the screen's height */
  const HANDOVER = 0.5; // must match --handover
  const DWELL_FIRST = 0.42; // the hero has been on screen since the page opened
  const DWELL = 0.55;
  /* The swap, as shares of the hand-over: out, then in, never both (D89). The outgoing section holds, then
     drops quickly (ease-in); the incoming one arrives quickly, then settles (ease-out). That keeps the
     moment where neither is clearly visible to a few frames, without the two ever showing together. */
  const OUT_START = 0.12;
  const OUT_END = 0.48;
  const IN_START = 0.5;
  const IN_END = 0.82;

  function initFadeSequence(root: HTMLElement) {
    const steps = [...root.querySelectorAll<HTMLElement>(':scope > .fade-step')];
    if (steps.length < 2) return;
    const views = steps.map((s) => s.querySelector<HTMLElement>(':scope > .fade-view'));
    const bands = views.map((v) => (v?.firstElementChild as HTMLElement | null) ?? null);
    const grounds = steps.map((s) => s.querySelector<HTMLElement>(':scope > .fade-bg'));
    const marked = steps.map((s) => ({
      text: [...s.querySelectorAll<HTMLElement>('[data-fade="text"]')],
      fixed: [...s.querySelectorAll<HTMLElement>('[data-fade="fixed"]')],
      visual: [...s.querySelectorAll<HTMLElement>('[data-fade="visual"]')],
      poster: [...s.querySelectorAll<HTMLElement>('.hero > .stage')],
    }));
    /* A layer whose box is switched off (`display: contents`, as "The clinic" does on phones to re-order its
       words around the photograph) draws nothing of its own, so opacity and transform written to it are
       ignored and its words stayed on screen over the hero (D90). The script writes to the boxes that are
       drawn: the layer itself, or its children when it has no box. Worked out again on every measure,
       because a layout can switch at a breakpoint. */
    const boxes = (els: HTMLElement[]): HTMLElement[] =>
      els.flatMap((el) => (getComputedStyle(el).display === 'contents' ? boxes([...el.children] as HTMLElement[]) : [el]));
    const resolve = () =>
      marked.map((m) => ({ text: boxes(m.text), fixed: boxes(m.fixed), visual: boxes(m.visual), poster: m.poster }));
    let layers = marked;
    const stages = steps.map((s) => [...s.querySelectorAll<Stage>('[data-scene]')]);
    const touched = new Set<HTMLElement>();
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const tall = window.matchMedia('(min-height: 37.5em)');
    const last = steps.length - 1;
    const geo = steps.map(() => ({ lead: 0, overflow: 0, dwell: 0, len: 0 }));
    let T = 0;
    let enabled = false;
    let frame = 0;
    let written = new WeakMap<HTMLElement, { opacity?: string; transform?: string }>();

    const clamp = (t: number) => Math.min(1, Math.max(0, t));
    const smooth = (t: number) => t * t * (3 - 2 * t);
    const ramp = (q: number, from: number, to: number) => smooth(clamp((q - from) / (to - from)));
    const easeIn = (t: number) => t * t * t;
    const easeOut = (t: number) => 1 - (1 - t) ** 3;
    // write a style only when its value changed: a scroll frame touches a few layers, nothing else
    const put = (el: HTMLElement, prop: 'opacity' | 'transform', value: string) => {
      let w = written.get(el);
      if (!w) written.set(el, (w = {}));
      if (w[prop] === value) return;
      w[prop] = value;
      el.style[prop] = value;
      touched.add(el);
    };
    const release = (el: HTMLElement) => {
      el.style.opacity = '';
      el.style.transform = '';
      el.style.willChange = '';
      written.delete(el);
      touched.delete(el);
    };
    const relayer = () => {
      layers = resolve();
      const now = new Set<HTMLElement>([...grounds, ...bands].filter(Boolean) as HTMLElement[]);
      for (const l of layers) {
        for (const el of [...l.text, ...l.fixed, ...l.visual]) {
          now.add(el);
          // a stand-in for a layer without a box gets the layer's own compositor hint
          if (!el.hasAttribute('data-fade')) el.style.willChange = 'opacity, transform';
        }
        l.poster.forEach((el) => now.add(el));
      }
      for (const el of [...touched]) if (!now.has(el)) release(el);
    };
    const attr = (el: HTMLElement, name: string, value: string | null) => {
      if (el.getAttribute(name) === value) return;
      if (value === null) el.removeAttribute(name);
      else el.setAttribute(name, value);
    };

    const measure = () => {
      if (!enabled) return;
      relayer();
      const V = views[0]?.clientHeight || window.innerHeight;
      T = Math.round(V * HANDOVER);
      steps.forEach((step, i) => {
        const g = geo[i];
        g.lead = i === 0 ? 0 : T;
        if (i === last || !bands[i]) {
          // a section that pins itself starts its own show after the hand-over
          step.style.setProperty('--spiral-lead', `${T}px`);
          return;
        }
        g.overflow = Math.max(0, bands[i]!.offsetHeight - V);
        g.dwell = Math.round(V * (i === 0 ? DWELL_FIRST : DWELL));
        g.len = g.lead + g.overflow + g.dwell + T;
        step.style.setProperty('--len', `${g.len}px`);
      });
      window.dispatchEvent(new Event('fadeseq:measure'));
    };

    const update = () => {
      frame = 0;
      if (!enabled) return;
      const q = steps.map(() => 0);
      const scrolled = steps.map((s) => -s.getBoundingClientRect().top);
      for (let i = 0; i < last; i++) {
        const g = geo[i];
        q[i] = clamp((scrolled[i] - g.lead - g.overflow - g.dwell) / (T || 1));
      }
      steps.forEach((step, i) => {
        const g = geo[i];
        const qin = i === 0 ? 1 : q[i - 1];
        const qout = i === last ? 0 : q[i];
        const inT = i === 0 ? 1 : easeOut(clamp((qin - IN_START) / (IN_END - IN_START)));
        const outT = easeIn(clamp((qout - OUT_START) / (OUT_END - OUT_START)));
        const shown = Math.min(inT, 1 - outT);
        // the next ground comes in across the swap itself, so the colour is moving while the content changes
        const bg = i === 0 ? 1 : ramp(qin, 0.3, 0.64);
        const gone = (i > 0 && qin <= 0.001) || (i < last && qout >= 0.999);
        const rise = (1 - inT) * 16 - outT * 12;
        const life = g.overflow + g.dwell + T;
        const drift = i < last ? clamp((scrolled[i] - g.lead) / (life || 1)) : 0;
        const o = shown.toFixed(3);
        const L = layers[i];
        for (const el of L.text) {
          put(el, 'opacity', o);
          put(el, 'transform', `translate3d(0, ${(rise - drift * 22).toFixed(1)}px, 0)`);
        }
        for (const el of L.fixed) put(el, 'opacity', o);
        for (const el of L.visual) {
          put(el, 'opacity', o);
          put(el, 'transform', `translate3d(0, ${(drift * 26 - 13).toFixed(1)}px, 0) scale(${(1 + drift * 0.035).toFixed(4)})`);
        }
        for (const el of L.poster) put(el, 'opacity', o);
        if (grounds[i]) put(grounds[i]!, 'opacity', bg.toFixed(3));
        if (i < last && bands[i]) put(bands[i]!, 'transform', `translate3d(0, ${(-Math.min(g.overflow, Math.max(0, scrolled[i] - g.lead))).toFixed(1)}px, 0)`);
        attr(step, 'data-faded', gone ? (i > 0 && qin <= 0.001 ? 'next' : 'past') : null);
        attr(step, 'data-inert', shown < 0.5 ? '' : null);
        if (i < last) {
          stages[i].forEach((el) => {
            el.__fade = gone ? 0 : shown;
            el.__seq = clamp(scrolled[i] / (g.len || 1));
          });
        }
      });
    };
    /* Worked out in the scroll event itself, not in an animation frame of its own (D90). Browsers send the
       scroll event once per frame, just before animation frames run, so the shared 3D canvas (drawn in the
       engine's animation frame, reading `stage.__fade`) and these words change in the same frame. From an
       animation frame of its own this ran after the engine's, so on a quick scroll back to the hero its words
       were up one frame before its portrait. */
    const onScroll = () => {
      if (frame) cancelAnimationFrame(frame);
      update();
    };
    const onResize = () => {
      measure();
      if (!frame) frame = requestAnimationFrame(update);
    };

    /* Bringing something inside the sequence into view (keyboard focus, a link to an id): go to the
       point where its section is fully shown, moved up inside its window far enough to show it. */
    const reveal = (el: Element | null) => {
      if (!enabled || !el) return;
      const i = steps.findIndex((s) => s.contains(el));
      if (i < 0 || !steps[i].hasAttribute('data-inert')) return;
      const g = geo[i];
      const top = steps[i].getBoundingClientRect().top + window.scrollY;
      let inside = 0;
      if (bands[i] && g.overflow > 0) {
        const V = views[i]!.clientHeight;
        const offset = el.getBoundingClientRect().top - bands[i]!.getBoundingClientRect().top;
        inside = Math.min(g.overflow, Math.max(0, offset - V * 0.35));
      }
      const y = Math.round(top + g.lead + inside + 2);
      const lenis = (window as Window & { __lenis?: Lenis }).__lenis;
      if (lenis) lenis.scrollTo(y, { immediate: true });
      else window.scrollTo(0, y);
      update();
    };
    const onFocus = (e: FocusEvent) => reveal(e.target as Element);
    const onHash = () => reveal(location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null);

    // Only the sections' own size matters. The window's height is not watched: phones change it while the
    // address bar slides during a scroll, and the held windows are sized in svh, which does not move.
    const observer = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(onResize) : null;
    let lastW = window.innerWidth;
    const onWindowResize = () => {
      if (window.innerWidth === lastW) return;
      lastW = window.innerWidth;
      onResize();
    };
    /* A held section's photograph is decoded ahead of its hand-over, once the page has loaded and the phone is
       idle (D90). Left to the moment it first fades in, the decode landed in the hand-over itself: a stall of
       a few hundred milliseconds, then a frame with an empty white frame where the photograph should be. */
    let warmed = false;
    const warm = () => {
      if (warmed) return;
      warmed = true;
      const go = () =>
        views.slice(1).forEach((v) =>
          v?.querySelectorAll('img').forEach((img) => {
            img.loading = 'eager';
            img.decode?.().catch(() => {});
          }),
        );
      const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 2500 }) : setTimeout(go, 1200));
      if (document.readyState === 'complete') idle();
      else window.addEventListener('load', idle, { once: true });
    };
    const apply = () => {
      enabled = !still.matches && tall.matches;
      root.toggleAttribute('data-on', enabled);
      if (enabled) {
        warm();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onWindowResize, { passive: true });
        window.addEventListener('hashchange', onHash);
        root.addEventListener('focusin', onFocus);
        bands.forEach((b) => b && observer?.observe(b));
        measure();
        update();
        onHash();
      } else {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onWindowResize);
        window.removeEventListener('hashchange', onHash);
        root.removeEventListener('focusin', onFocus);
        observer?.disconnect();
        [...touched].forEach(release);
        written = new WeakMap();
        steps.forEach((step, i) => {
          ['--len', '--spiral-lead'].forEach((v) => step.style.removeProperty(v));
          step.removeAttribute('data-faded');
          step.removeAttribute('data-inert');
          stages[i].forEach((el) => {
            delete el.__fade;
            delete el.__seq;
          });
        });
        window.dispatchEvent(new Event('fadeseq:measure'));
      }
    };
    still.addEventListener('change', apply);
    tall.addEventListener('change', apply);
    apply();
  }
  document.querySelectorAll<HTMLElement>('[data-fade-seq]').forEach((el) => initFadeSequence(el));
</script>
