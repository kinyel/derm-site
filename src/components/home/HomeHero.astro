---
/**
 * Home hero (owner, D65 and D77): label + short display headline on two lines (second line in pink),
 * one-line answer, two actions, and a three-column strip of what the clinic does, on a light ground
 * washed with glacier blue, light pink and white. The portrait and the glass mark beside it are the
 * 3D stage behind the text (§11.5); there are no ribbons.
 *
 * The h1 holds both the label, which carries the search phrase, and the display line, so the
 * page keeps one descriptive h1 while the headline stays short.
 */
import { getImage } from 'astro:assets';
import Band from '../Band.astro';
import Stage from '../Stage.astro';
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import { clinic, experienceFragment, whatsappHref } from '../../data/clinic.ts';
import { loadAll, paths } from '../../lib/content.ts';
import { heroAssets } from '../../lib/hero.ts';

const all = await loadAll();
const assets = await heroAssets(getImage);
const service = (id: string) => all.services.find((s) => s.id === id);
const strip = [
  { id: 'clinical-dermatology', tone: 'blush', title: 'Dermatology', text: 'Care for skin, hair and nails, for adults and children.' },
  { id: 'aesthetic-treatments', tone: 'glacier', title: 'Aesthetics and laser', text: 'Injectables, peels and lasers matched to your skin type.' },
  { id: 'internal-medicine', tone: 'leaf', title: 'Internal medicine', text: 'General medical care, blood pressure, diabetes and cholesterol.' },
]
  .map((p) => ({ ...p, entry: service(p.id) }))
  .filter((p) => p.entry);
---

<Band tone="mist" first hero="home" as="header" class="hero">
  <Stage scene="hero" behind priority surface="light" layer="front" p="9 / 19" l="19 / 9" d="16 / 10" params={{ ...assets, mode: 'home' }} />
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="container hero__inner" data-fade="text">
    <div class="hero__text" data-hero-text>
      <h1 class="hero__h1">
        <span class="eyebrow hero__eyebrow"><span class="hero__eyebrow-text"><span>Dermatologist in Lagos,</span> <span>{clinic.address.addressLocality}</span></span></span>
        <span class="hero__title">
          <span>Healthy skin. Clear answers.</span>
          <span class="hero__accent">Care that fits you.</span>
        </span>
      </h1>
      <p class="hero__lead" data-answer>
        {clinic.name} is a dermatology clinic in {clinic.address.neighbourhood}, {clinic.address.addressLocality}, {clinic.city}, for skin, hair and nails in every skin type and tone, led by a consultant with {experienceFragment}.
      </p>
      <div class="hero__actions">
        <Button href="/book-appointment/" size="large" event="book_click">Book an appointment</Button>
        <Button href={whatsappHref} variant="secondary" size="large" event="whatsapp_click">Chat on WhatsApp</Button>
      </div>
    </div>
  </div>
  <div class="hero__strip" data-fade="fixed">
    <ul class="container hero__pillars" role="list">
      {
        strip.map((p) => (
          <li>
            <a class="hero__pillar" href={paths.service(p.entry!.id)} data-tone={p.tone}>
              <span class="hero__pillar-icon"><Icon name={p.entry!.data.icon} size="l" solid /></span>
              <span class="hero__pillar-text">
                <strong>{p.title}</strong>
                <span>{p.text}</span>
              </span>
              <span class="hero__pillar-go" aria-hidden="true"><Icon name="arrow" solid /></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Band>

<style>
  .hero {
    --band-bg: var(--grad-hero);
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    overflow-x: clip;
    padding-block-end: 0;
  }
  /* Keeps the text on a calm, near-white ground where the 3D passes behind it */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim-light-inline);
    pointer-events: none;
  }
  .hero__inner {
    width: min(100% - 2 * var(--page-pad), var(--content-max));
    padding-block: var(--space-l) var(--space-xl);
  }
  .hero__text {
    display: grid;
    gap: var(--space-m);
    max-width: 39rem;
    container-type: inline-size;
  }
  .hero__h1 {
    display: grid;
    gap: var(--space-s);
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: normal;
    line-height: inherit;
  }
  .hero__eyebrow {
    font-weight: 700;
    letter-spacing: 0.2em;
  }
  .hero__eyebrow::before {
    width: 2.75rem;
  }
  /* The label may wrap on narrow phones, but only between the keyword and the area. */
  .hero__eyebrow-text > span {
    white-space: nowrap;
  }
  .hero__title {
    display: grid;
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    animation: hero-rise var(--dur-reveal) var(--ease-out) both;
  }
  /* Two lines at every size (owner, D72): the first line is 10.35em wide, so the type is sized
     from the text column (9.5% of its width) and never wraps or outgrows it. */
  @supports (width: 1cqi) {
    .hero__title {
      font-size: min(var(--step-5), 9.5cqi);
    }
    .hero__title > span {
      white-space: nowrap;
    }
  }
  .hero__accent {
    color: var(--blush-600);
  }
  .hero__lead {
    max-width: 33rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
    animation: hero-fade var(--dur-reveal) var(--ease-out) 120ms both;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    animation: hero-fade var(--dur-reveal) var(--ease-out) 220ms both;
  }

  /* The strip: what the clinic does, in three boxes along the foot of the hero.
     On wide screens it covers the left 70% only, flush with the left and bottom edges, so the portrait
     keeps the right-hand column from top to bottom (owner, D79, D80). On phones and upright tablets it
     runs edge to edge. */
  .hero__strip {
    position: relative;
    z-index: var(--z-content);
    border-block-start: 1px solid var(--rule);
    background: rgb(255 255 255 / 0.92);
  }
  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .hero__strip {
      background: rgb(255 255 255 / 0.84);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
      backdrop-filter: blur(14px) saturate(140%);
    }
  }
  .hero__pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .hero__pillars > li + li {
    border-inline-start: 1px solid var(--rule);
  }
  /* One box: a tinted icon tile, the name and a line about it, and an arrow that arrives on hover */
  .hero__pillar {
    --tone: var(--blush-600);
    --tone-soft: var(--blush-100);
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-s);
    height: 100%;
    padding: var(--space-s) var(--space-m);
    color: var(--ink);
    text-decoration: none;
    isolation: isolate;
  }
  .hero__pillar[data-tone='glacier'] {
    --tone: var(--glacier-600);
    --tone-soft: var(--glacier-100);
  }
  .hero__pillar[data-tone='leaf'] {
    --tone: var(--leaf-700);
    --tone-soft: var(--leaf-100);
  }
  /* a wash of the box's own colour rises from the foot, and a line draws along the top edge */
  .hero__pillar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(255 255 255 / 0), var(--tone-soft));
    opacity: 0;
    transition: opacity var(--dur-ui) var(--ease-out);
  }
  .hero__pillar::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--tone);
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale var(--dur-ui) var(--ease-out);
  }
  .hero__pillar-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--r-card);
    background: var(--tone-soft);
    color: var(--tone);
    transition:
      background-color var(--dur-ui) var(--ease-out),
      color var(--dur-ui) var(--ease-out),
      rotate var(--dur-ui) var(--ease-out),
      scale var(--dur-ui) var(--ease-out);
  }
  .hero__pillar-icon :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
    stroke-width: 1.5;
  }
  .hero__pillar-text {
    display: grid;
    gap: 0.15rem;
  }
  .hero__pillar strong {
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.2;
    transition: color var(--dur-micro) var(--ease-out);
  }
  .hero__pillar-text > span {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }
  .hero__pillar-go {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--r-pill);
    background: var(--tone);
    color: var(--white);
    opacity: 0;
    translate: -0.5rem 0;
    transition:
      opacity var(--dur-micro) var(--ease-out),
      translate var(--dur-ui) var(--ease-out);
  }
  .hero__pillar-go :global(.icon) {
    width: 0.9375rem;
    height: 0.9375rem;
    stroke-width: 2;
  }
  .hero__pillar:hover::before,
  .hero__pillar:focus-visible::before {
    opacity: 1;
  }
  .hero__pillar:hover::after,
  .hero__pillar:focus-visible::after {
    scale: 1 1;
  }
  .hero__pillar:hover .hero__pillar-icon,
  .hero__pillar:focus-visible .hero__pillar-icon {
    background: var(--tone);
    color: var(--white);
    rotate: -6deg;
    scale: 1.06;
  }
  .hero__pillar:hover strong,
  .hero__pillar:focus-visible strong {
    color: var(--tone);
  }
  .hero__pillar:hover .hero__pillar-go,
  .hero__pillar:focus-visible .hero__pillar-go {
    opacity: 1;
    translate: 0 0;
  }

  @keyframes hero-rise {
    from {
      transform: translateY(0.35em);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  /* Portrait phones and tablets: text on top, portrait below, buttons side by side */
  @media (max-width: 63.99em) and (orientation: portrait) {
    .hero {
      align-items: start;
    }
    .hero__scrim {
      background: var(--scrim-light-block);
    }
    .hero__inner {
      padding-block-end: min(42vh, 24rem);
      padding-block-end: min(42svh, 24rem);
    }
  }
  @media (max-width: 47.99em) {
    .hero__text {
      gap: var(--space-s);
    }
    .hero__eyebrow {
      letter-spacing: 0.16em;
    }
    .hero__lead {
      font-size: 1rem;
    }
    .hero__actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xs);
    }
    /* two buttons share the row: tighter plate, smaller chip, and the label may take two lines */
    .hero__actions :global(.btn) {
      --btn-h: 3rem;
      --btn-px: 0.75rem;
      --chip: 1.75rem;
      gap: 0.4rem;
      min-width: 0;
      font-size: 0.875rem;
    }
  }
  /* Phones and narrow tablets: three compact boxes, tile above the name */
  @media (max-width: 63.99em) {
    .hero__pillar {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      row-gap: var(--space-2xs);
      padding: var(--space-s) var(--space-3xs);
      text-align: center;
    }
    .hero__pillar-icon {
      width: 2.5rem;
      height: 2.5rem;
    }
    .hero__pillar-icon :global(.icon) {
      width: 1.25rem;
      height: 1.25rem;
    }
    .hero__pillar strong {
      font-size: 0.9375rem;
    }
    .hero__pillar-text > span,
    .hero__pillar-go {
      display: none;
    }
  }
  /* Phones on their side */
  @media (orientation: landscape) and (max-height: 30em) {
    .hero__text {
      max-width: 56%;
      gap: var(--space-xs);
    }
    .hero__title {
      font-size: min(var(--step-3), 9.5cqi);
    }
    .hero__lead {
      font-size: 1rem;
    }
    .hero__inner {
      padding-block: var(--space-s);
    }
    .hero__pillar {
      padding-block: var(--space-xs);
    }
    .hero__pillar-text > span,
    .hero__pillar-icon,
    .hero__pillar-go {
      display: none;
    }
  }
  @media (min-width: 64em) {
    .hero__text {
      max-width: min(50%, 39rem);
    }
    /* Flush with the hero's left and bottom edges (owner, D80). The three boxes cover 70% of the hero's
       width; the glass runs on behind the portrait and dissolves there (owner, D83, D86). The portrait is
       drawn in FRONT of this strip, so the last box slips behind her arm. Where the glass ends it warms
       from white through the faintest glacier blue to pink, the colours of the ground it is fading into,
       and a long eased mask takes the tint, the blur and the hairline out together, so there is no edge
       to see: only her arm resting on a box of light. The last box's words end before any of this begins. */
    .hero__strip {
      --boxes: 70;
      --reach: 88;
      width: calc(var(--reach) * 1%);
      margin: 0;
      border-inline: 0;
      border-block-end: 0;
      border-radius: 0;
      background:
        linear-gradient(90deg, rgb(255 255 255 / 0.9) 0%, rgb(255 255 255 / 0.9) 58%, rgb(243 249 254 / 0.78) 72%, rgb(225 242 253 / 0.6) 84%, rgb(255 230 240 / 0.42) 100%);
      -webkit-mask-image: linear-gradient(90deg, #000 0, #000 66%, rgb(0 0 0 / 0.86) 72%, rgb(0 0 0 / 0.64) 78%, rgb(0 0 0 / 0.42) 84%, rgb(0 0 0 / 0.22) 90%, rgb(0 0 0 / 0.08) 95%, transparent 100%);
      mask-image: linear-gradient(90deg, #000 0, #000 66%, rgb(0 0 0 / 0.86) 72%, rgb(0 0 0 / 0.64) 78%, rgb(0 0 0 / 0.42) 84%, rgb(0 0 0 / 0.22) 90%, rgb(0 0 0 / 0.08) 95%, transparent 100%);
    }
    @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
      .hero__strip {
        background:
          linear-gradient(90deg, rgb(255 255 255 / 0.84) 0%, rgb(255 255 255 / 0.84) 58%, rgb(243 249 254 / 0.7) 72%, rgb(225 242 253 / 0.5) 84%, rgb(255 230 240 / 0.34) 100%);
      }
    }
    .hero__pillars {
      width: calc(var(--boxes) / var(--reach) * 100%);
      max-width: none;
      margin: 0;
      padding: 0;
    }
    /* the first box keeps the page's side padding so its tile is not against the glass */
    .hero__pillars > li:first-child .hero__pillar {
      padding-inline-start: var(--page-pad);
    }
  }
  /* the line about each service needs room: below this the boxes show the tile and the name */
  @media (min-width: 64em) and (max-width: 84.99em) {
    .hero__pillar {
      padding-inline: var(--space-s);
    }
    .hero__pillar-text > span {
      display: none;
    }
  }
</style>
