---
/** Home §2 "The clinic": who we are, the experience statement and links, beside the portrait pane. */
import Band from '../Band.astro';
import Media from '../Media.astro';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { clinic, experienceStatement, leadPath, leadName } from '../../data/clinic.ts';
---

<Band tone="reading" labelledby="clinic-heading">
  <div class="container clinic">
    <div class="clinic__text" data-fade="text">
      <SectionHead
        id="clinic-heading"
        eyebrow="The clinic"
        title="Your skin doctor on the Island"
        lead={`${clinic.name} is a dermatology clinic on ${clinic.address.streetAddress.replace(/^\d+\s*/, '')} in ${clinic.address.neighbourhood}, ${clinic.address.addressLocality}, next to Lekki Phase 1 and one bridge from Ikoyi.`}
      />
      <p class="clinic__body">
        People come to us when they want a skin specialist in Lagos who will examine them properly, explain the diagnosis in plain words and plan
        treatment that suits their skin, whatever its type or tone. The same clinic looks after children, adults and older people, in person or by online consultation.
      </p>
      <p class="clinic__statement">{experienceStatement()}</p>
      <p class="cluster" style="--cluster: var(--space-2xs) var(--space-l)">
        <a class="link link--arrow" href="/about/">About the clinic <Icon name="arrow" solid /></a>
        <a class="link link--arrow" href={leadPath}>Meet {leadName()} <Icon name="arrow" solid /></a>
      </p>
    </div>
    <div class="pane tilt" data-pane data-fade="visual">
      <Media id="real/specialist-portrait" feature sizes="(min-width: 64em) 30vw, 70vw" />
      <span class="pane__edge" aria-hidden="true"></span>
    </div>
  </div>
</Band>

<style>
  .clinic {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
  }
  .clinic :global(.section-head) {
    margin-block-end: var(--space-m);
  }
  .clinic__body {
    max-width: 38rem;
    color: var(--ink-soft);
  }
  .clinic__statement {
    max-width: 34rem;
    margin-block: var(--space-m);
    padding-inline-start: var(--space-m);
    border-inline-start: 3px solid transparent;
    border-image: var(--grad-aurora) 1;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .pane {
    position: relative;
    width: 100%;
    max-width: 22rem;
    padding: var(--space-xs);
    border-radius: calc(var(--r-feature) + var(--space-xs));
    border: 1px solid transparent;
    background: var(--grad-light-panel) padding-box, var(--grad-hairline-strong) border-box;
    box-shadow: var(--shadow-panel-lift);
    --ry: 0deg;
    --rx: 0deg;
  }
  .pane__edge {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    /* A plain see-through white gloss (D90). It was a soft-light blend, which made the browser repaint the
       whole panel against everything under it the moment the section faded in: about 30ms of drawing in
       one frame, a visible hitch in the hand-over on phones. These strengths match the old look closely. */
    background: linear-gradient(115deg, rgb(255 255 255 / 0.26), transparent 28%, transparent 70%, rgb(255 255 255 / 0.17));
    pointer-events: none;
  }
  @media (min-width: 64em) {
    .clinic {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .pane {
      max-width: 26rem;
      justify-self: end;
      --ry: -5deg;
      --rx: 2deg;
    }
  }

  /* ---------- Phones (owner, D88) ----------
     Heading, then her photograph set to the right with the statement as a white card overlapping its
     lower left edge, then the paragraph and the links. The words come first in the page's code; only the
     order on screen changes. */
  @media (max-width: 47.99em) {
    .clinic {
      gap: 0;
    }
    .clinic__text {
      display: contents;
    }
    .clinic :global(.section-head) {
      order: 1;
      margin-block-end: var(--space-m);
    }
    .pane {
      order: 2;
      width: 84%;
      max-width: 20rem;
      justify-self: end;
    }
    .clinic__statement {
      order: 3;
      position: relative;
      z-index: 2;
      width: 82%;
      margin-block-start: -4.5rem;
      padding: var(--space-s) var(--space-s) var(--space-s) var(--space-m);
      border-radius: var(--r-card);
      background: var(--white);
      box-shadow: 0 1px 2px rgb(15 26 44 / 0.06), 0 18px 36px -18px rgb(23 60 110 / 0.35);
      font-size: var(--step-0);
    }
    .clinic__body {
      order: 4;
      margin-block-start: var(--space-m);
    }
    .clinic > .clinic__text > :last-child {
      order: 5;
      margin-block-start: var(--space-s);
    }
  }

  /* phones on their side (D88): words on the left, her photograph beside them */
  @media (orientation: landscape) and (max-height: 30em) {
    .clinic {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: center;
      gap: var(--space-l);
    }
    .pane {
      max-width: 15rem;
      justify-self: end;
    }
  }
</style>
