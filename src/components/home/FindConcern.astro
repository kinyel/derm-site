---
/** Home §4 "Find your concern": body areas → conditions. The 3D figure's hotspots mirror these links. */
import Band from '../Band.astro';
import Stage from '../Stage.astro';
import SectionHead from '../SectionHead.astro';
import { loadAll, conditionsByArea, paths } from '../../lib/content.ts';

const all = await loadAll();
const areas = conditionsByArea(all).map((a) => ({
  ...a,
  total: a.conditions.length,
  conditions: [...a.conditions].sort((x, y) => (x.data.topRank ?? 50) - (y.data.topRank ?? 50)).slice(0, 5),
}));
---

<Band tone="reading" labelledby="concern-heading">
  <div class="container">
    <SectionHead
      id="concern-heading"
      eyebrow="Conditions"
      title="Find your concern"
      lead="Start with where the trouble is. Each guide explains what the condition looks like, including on brown and Black skin, and when to have it checked."
      action={{ href: '/conditions/', label: 'All conditions A–Z' }}
    />
    <div class="concern">
      <div class="concern__areas" data-areas data-rail>
        {
          areas.map((a, i) => (
            <section class="concern__area" data-area={a.id}>
              <p class="concern__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              <h3>
                <a href={`/conditions/#area-${a.id}`} data-hotspot={`/conditions/#area-${a.id}`}>{a.label}</a>
              </h3>
              <ul class="link-list" role="list">
                {a.conditions.map((c) => (
                  <li>
                    <a href={paths.condition(c.id)}><span>{c.data.shortTitle}</span></a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <div class="concern__stage">
        <Stage scene="figure" interactive p="3 / 4" l="3 / 4" d="4 / 5" />
      </div>
    </div>
  </div>
</Band>

<style>
  .concern {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .concern__areas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-l) var(--gutter);
  }
  .concern__area {
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--rule);
  }
  .concern__num {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--label);
  }
  .concern__area h3 {
    margin-block: var(--space-3xs) var(--space-xs);
    font-size: var(--step-1);
  }
  .concern__area h3 a {
    color: inherit;
    text-decoration: none;
  }
  .concern__area h3 a:hover {
    color: var(--blush-700);
  }
  .concern__stage {
    width: 100%;
    max-width: 14rem;
  }
  @media (min-width: 64em) {
    .concern {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }
    .concern__areas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .concern__stage {
      max-width: 22rem;
      justify-self: end;
    }
  }

  /* ---------- Phones and tablets (owner, D88) ----------
     The body figure comes first, then the areas. On phones the areas are cards you swipe through, each
     with its own list, the next one peeking in from the right; every link stays in the page. */
  @media (max-width: 63.99em) {
    .concern {
      gap: var(--space-m);
    }
    .concern__stage {
      order: -1;
      width: min(100%, 17rem);
      justify-self: center;
    }
  }
  @media (max-width: 47.99em) and (orientation: portrait), (orientation: landscape) and (max-height: 30em) {
    .concern__areas {
      display: flex;
      gap: var(--space-xs);
      margin-inline: calc(-1 * var(--page-pad));
      padding: var(--space-3xs) var(--page-pad) var(--space-s);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-pad);
      scrollbar-width: none;
    }
    .concern__areas::-webkit-scrollbar {
      display: none;
    }
    .concern__area {
      flex: 0 0 min(78%, 19rem);
      scroll-snap-align: start;
      padding: var(--space-s) var(--space-m) var(--space-xs);
      border: 1px solid var(--rule);
      border-radius: var(--r-feature);
      background: var(--white);
      box-shadow: 0 14px 30px -22px rgb(23 60 110 / 0.35);
    }
  }
  /* upright tablets: the figure beside the areas, two columns of areas */
  @media (min-width: 48em) and (max-width: 63.99em) and (orientation: portrait) {
    .concern {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
    .concern__stage {
      position: sticky;
      top: calc(var(--nav-h) + var(--space-s));
      width: 100%;
    }
    .concern__areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* phones on their side: the figure on the left, the cards beside it */
  @media (orientation: landscape) and (max-height: 30em) {
    .concern {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: center;
    }
    .concern__stage {
      width: 100%;
      max-height: 78svh;
    }
    .concern__areas {
      margin-inline-start: 0;
      padding-inline-start: 0;
      scroll-padding-inline: 0;
    }
    .concern__area {
      flex-basis: min(64%, 17rem);
    }
  }

  @media (pointer: coarse) {
    .concern__area h3 a {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
      min-width: var(--tap);
    }
  }
</style>
