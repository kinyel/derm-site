---
/** Home §6 "Your visit": five numbered steps on one line. */
import Band from '../Band.astro';
import SectionHead from '../SectionHead.astro';

const steps = [
  { title: 'Book', text: 'Send a WhatsApp message, call, or use the form. We reply with a time.' },
  { title: 'Consultation', text: 'The dermatologist listens, examines your skin, hair or nails and explains what is going on.' },
  { title: 'Tests if needed', text: 'Some conditions need a scraping, a biopsy, a patch test or blood tests before treatment.' },
  { title: 'Treatment plan', text: 'You leave with a written plan: what to use, what to avoid and what to expect.' },
  { title: 'Follow-up', text: 'We check progress, adjust treatment and keep photographs when that helps.' },
];
---

<Band tone="reading" labelledby="visit-heading">
  <div class="container">
    <SectionHead
      id="visit-heading"
      eyebrow="Your visit"
      title="Your visit, step by step"
      lead="A first consultation follows the same five steps whether you come in person or book an online consultation."
      action={{ href: '/your-visit/', label: 'What to expect at your visit' }}
    />
    <ol class="visit-steps" role="list" data-steps data-rail>
      {
        steps.map((s, i) => (
          <li data-step>
            <p class="visit-steps__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Band>

<style>
  .visit-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-l) var(--gutter);
  }
  .visit-steps > li {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--rule);
  }
  /* a short gradient mark starts each step's rule */
  .visit-steps > li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background: var(--grad-aurora);
  }
  .visit-steps__num {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--label);
  }
  .visit-steps h3 {
    font-size: var(--step-1);
  }
  .visit-steps > li > p:last-child {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  @media (min-width: 64em) {
    .visit-steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* ---------- Phones (owner, D88): a timeline ----------
     One line runs down the left in the brand gradient; each step hangs from it on a numbered node. */
  @media (max-width: 47.99em) {
    .visit-steps {
      position: relative;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-m);
      padding-inline-start: 3.25rem;
    }
    .visit-steps::before {
      content: '';
      position: absolute;
      top: 1.1rem;
      bottom: 1.1rem;
      left: 1.1rem;
      width: 2px;
      border-radius: 2px;
      background: var(--grad-aurora);
      opacity: 0.55;
    }
    .visit-steps > li {
      padding-block-start: 0;
      border: 0;
    }
    .visit-steps > li::before {
      content: none;
    }
    .visit-steps__num {
      position: absolute;
      left: -3.25rem;
      top: -0.1rem;
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: var(--r-pill);
      background: var(--white);
      box-shadow: 0 0 0 1.5px var(--glacier-200), 0 6px 14px -8px rgb(23 60 110 / 0.4);
      color: var(--blush-700);
      letter-spacing: 0.04em;
    }
    .visit-steps h3 {
      font-size: var(--step-0);
      font-weight: 700;
      line-height: 1.3;
    }
  }
  /* phones on their side: the five steps in one row you swipe */
  @media (orientation: landscape) and (max-height: 30em) and (max-width: 63.99em) {
    .visit-steps {
      display: flex;
      gap: var(--space-s);
      margin-inline: calc(-1 * var(--page-pad));
      padding: 0 var(--page-pad) var(--space-xs);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-pad);
      scrollbar-width: none;
    }
    .visit-steps::-webkit-scrollbar {
      display: none;
    }
    .visit-steps > li {
      flex: 0 0 min(34%, 15rem);
      scroll-snap-align: start;
    }
  }
</style>
